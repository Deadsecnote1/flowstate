{
  "app-id": "io.github.Deadsecnote1.Flowstate",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "command": "flowstate",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--socket=session-bus",
    "--device=dri",
    "--filesystem=xdg-run/dconf",
    "--talk-name=ca.desrt.dconf",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/man",
    "/share/gtk-doc"
  ],
  "modules": [
    {
      "name": "flowstate",
      "buildsystem": "meson",
      "config-opts": [
        "--prefix=/app"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
